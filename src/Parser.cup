import java_cup.runtime.*;

parser code {:

    // ===== CONTADOR DE ERRORES =====
    public int errorCount = 0;

    // ===== RECUPERACIÓN DE ERRORES SINTÁCTICOS =====

    @Override
    public void syntax_error(Symbol cur_token) {
        errorCount++;
        int line   = cur_token.left;
        int column = cur_token.right;
        String lexema = (cur_token.value != null) ? cur_token.value.toString() : "";
        System.err.println("Error sintáctico en línea " + line +
                           ", columna " + column +
                           ": token inesperado '" + lexema + "'");
        Lexer.writeError(line, column, lexema);
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) throws Exception {
        errorCount++;
        int line   = cur_token.left;
        int column = cur_token.right;
        String lexema = (cur_token.value != null) ? cur_token.value.toString() : "";
        System.err.println("Error sintáctico irrecuperable en línea " + line +
                           ", columna " + column +
                           ": '" + lexema + "'. Se detiene el análisis.");
        Lexer.writeError(line, column, lexema);
        // No relanzar: dejar que CUP maneje el estado interno
    }

    // NOTA: NO se define main() aquí — ese método pertenece a Main.java
:}

// ===== TERMINALES (tokens del Lexer) =====

// Palabras reservadas
terminal EMPTY, INT, FLOAT, CHAR, BOOL, STRING;
terminal IF, ELSE, DO, WHILE, SWITCH, CASE, DEFAULT;
terminal RETURN, BREAK, CIN, COUT;
terminal MAIN;

// Operadores relacionales (palabras clave)
terminal EQUAL, N_EQUAL, LESS_T, LESS_TE, GREATER_T, GREATER_TE;
terminal GREATHER_T, GREATHER_TE;

// Delimitadores y símbolos
// LPAR = <|   RPAR = |>   (usados tanto en expresiones relacionales como en agrupación)
terminal LPAR, RPAR, LBLOCK, RBLOCK, LBRACKET, RBRACKET;
terminal ASSIGN, TILDE, EXCLAMATION, COMMA, COLON;

// Operadores aritméticos
terminal PLUS, MINUS, TIMES, DIVIDE, MOD, POWER;

// Operadores unarios / lógicos
terminal INCREMENT, DECREMENT;
terminal AND, OR, NOT;

// Literales
terminal Integer   INT_LIT;
terminal Float     FLOAT_LIT;
terminal String    EXP_LIT, FRAC_LIT;
terminal Boolean   BOOL_LIT;
terminal Character CHAR_LIT;
terminal String    STRING_LIT, ID;

// ===== NO TERMINALES =====
non terminal programa, funcion_lista, funcion, main_proc;
non terminal tipo_retorno, param_lista, param, tipo;
non terminal bloque, sentencia_lista, sentencia;
non terminal decl, asig, arr_access, arr_init;
non terminal control, if_stmt, do_while, switch_stmt;
non terminal case_lista, case_item;
non terminal return_stmt, io_stmt;
non terminal expr, expr_log, expr_rel, expr_arit, term, potencia, unario, primario;
non terminal llamada, arg_lista, literal;

// ===== PRECEDENCIA (menor a mayor) =====
// Las declaraciones de precedencia resuelven conflictos shift/reduce en CUP;
// la estructura jerárquica de la gramática ya impone el orden correcto,
// pero se mantienen aquí como respaldo.
precedence left OR;
precedence left AND;
precedence right NOT;
precedence left EQUAL, N_EQUAL, LESS_T, LESS_TE, GREATER_T, GREATER_TE, GREATHER_T, GREATHER_TE;
precedence left PLUS, MINUS;
precedence left TIMES, DIVIDE, MOD;
precedence right POWER;
precedence right INCREMENT, DECREMENT;

// ===== SÍMBOLO INICIAL =====
start with programa;

// ===== REGLAS GRAMATICALES =====

programa ::= funcion_lista main_proc
    | main_proc
    | error
    ;

funcion_lista ::= funcion
    | funcion_lista funcion
    ;

// El procedimiento principal: empty ~ __main__ <| |> bloque
main_proc ::= EMPTY TILDE MAIN LPAR RPAR bloque
    | EMPTY TILDE MAIN LPAR RPAR error
    ;

funcion ::= tipo_retorno TILDE ID TILDE LPAR param_lista RPAR bloque
    | tipo_retorno TILDE ID TILDE LPAR RPAR bloque
    | tipo_retorno TILDE ID TILDE LPAR param_lista RPAR error
    | tipo_retorno TILDE ID TILDE LPAR RPAR error
    ;

tipo_retorno ::= INT | FLOAT | CHAR | BOOL | STRING
    ;

param_lista ::= param
    | param_lista COMMA param
    ;

param ::= tipo TILDE ID
    ;

tipo ::= INT | FLOAT | BOOL | CHAR | STRING
    ;

// Bloque |: ... :|  con recuperación interna
bloque ::= LBLOCK sentencia_lista RBLOCK
    | LBLOCK RBLOCK
    | LBLOCK error RBLOCK
    ;

sentencia_lista ::= sentencia
    | sentencia_lista sentencia
    ;

// Cada sentencia termina en !  — modo pánico: ante error se descarta hasta !
sentencia ::= decl EXCLAMATION
    | asig EXCLAMATION
    | expr EXCLAMATION
    | control
    | return_stmt EXCLAMATION
    | BREAK EXCLAMATION
    | io_stmt EXCLAMATION
    | bloque
    ;
// ----- Declaraciones -----
decl ::= tipo TILDE ID
    | tipo TILDE ID ASSIGN expr
    | tipo TILDE ID LBRACKET INT_LIT RBRACKET LBRACKET INT_LIT RBRACKET
    | tipo TILDE ID LBRACKET INT_LIT RBRACKET LBRACKET INT_LIT RBRACKET ASSIGN LBLOCK arr_init RBLOCK
    ;

arr_init ::= expr
    | arr_init COMMA expr
    ;

// ----- Asignaciones -----
asig ::= ID ASSIGN expr
    | arr_access ASSIGN expr
    ;

// Acceso a arreglo bidimensional: id << expr >> << expr >>
arr_access ::= ID LBRACKET expr RBRACKET LBRACKET expr RBRACKET
    ;

// ----- Estructuras de control -----
control ::= if_stmt
    | do_while
    | switch_stmt
    ;

if_stmt ::= IF TILDE LPAR expr RPAR bloque
    | IF TILDE LPAR expr RPAR bloque ELSE TILDE bloque
    | IF TILDE LPAR expr RPAR bloque ELSE TILDE if_stmt
    | IF TILDE LPAR error RPAR bloque
    | IF TILDE LPAR error RPAR bloque ELSE TILDE bloque
    ;

do_while ::= DO TILDE bloque WHILE TILDE LPAR expr RPAR EXCLAMATION
    | DO TILDE bloque WHILE TILDE LPAR error RPAR EXCLAMATION
    ;

switch_stmt ::= SWITCH TILDE LPAR expr RPAR LBLOCK case_lista RBLOCK
    | SWITCH TILDE LPAR error RPAR LBLOCK case_lista RBLOCK
    ;

case_lista ::= case_item
    | case_lista case_item
    ;

case_item ::= CASE TILDE literal COLON sentencia_lista
    | DEFAULT COLON sentencia_lista
    | error COLON sentencia_lista
    ;

// ----- Return / IO -----
return_stmt ::= RETURN TILDE expr
    ;

io_stmt ::= CIN TILDE ID
    | COUT TILDE expr
    ;

// ===== EXPRESIONES =====
// Jerarquía: expr > expr_log > expr_rel > expr_arit > term > potencia > unario > primario

expr ::= expr_log
    ;

// Expresiones lógicas: conjunción (@) y disyunción (#)
expr_log ::= expr_log AND expr_rel
    | expr_log OR  expr_rel
    | expr_rel
    ;

// Expresiones relacionales: equal<|op1,op2|> etc.
// LPAR = <|  RPAR = |>   — los mismos tokens que agrupación aritmética
// CAMBIO: equal y n_equal usan expr (no expr_arit) para permitir operandos booleanos
expr_rel ::= EQUAL      LPAR expr COMMA expr RPAR
    | N_EQUAL            LPAR expr COMMA expr RPAR
    | LESS_T             LPAR expr_arit COMMA expr_arit RPAR
    | LESS_TE            LPAR expr_arit COMMA expr_arit RPAR
    | GREATER_T          LPAR expr_arit COMMA expr_arit RPAR
    | GREATER_TE         LPAR expr_arit COMMA expr_arit RPAR
    | GREATHER_T         LPAR expr_arit COMMA expr_arit RPAR
    | GREATHER_TE        LPAR expr_arit COMMA expr_arit RPAR
    | expr_arit
    ;

// Expresiones aritméticas aditivas
expr_arit ::= expr_arit PLUS  term
    | expr_arit MINUS term
    | term
    ;

// Multiplicativas / división / módulo
term ::= term TIMES   potencia
    | term DIVIDE  potencia
    | term MOD     potencia
    | potencia
    ;

// Potencia (asociativa derecha)
potencia ::= unario POWER potencia
    | unario
    ;

// Operadores unarios: - (negativo), ++id, --id, $ (NOT lógico)
unario ::= MINUS primario
    | INCREMENT ID
    | DECREMENT ID
    | NOT primario
    | primario
    ;

// Primario: literal, variable, acceso a arreglo, llamada a función, agrupación
primario ::= literal
    | ID
    | arr_access
    | llamada
    | LPAR expr RPAR
    ;

// Llamada a función: id ~ <| args |>
llamada ::= ID TILDE LPAR arg_lista RPAR
    | ID TILDE LPAR RPAR
    ;

arg_lista ::= expr
    | arg_lista COMMA expr
    ;

// Literales reconocidos
literal ::= INT_LIT
    | FLOAT_LIT
    | EXP_LIT
    | FRAC_LIT
    | BOOL_LIT
    | CHAR_LIT
    | STRING_LIT
    ;
